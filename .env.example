# Copy to .env and fill in. .env is git-ignored - never commit real values.

# --- Ollama Cloud API keys (at least one required) ---
# Add OLLAMA_API_KEY_2, _3, ... to fall back when a key hits its usage limit.
OLLAMA_API_KEY_1=your-ollama-api-key

# --- Concurrency / limits (optional, defaults shown) ---
MAX_WORKERS=10
PDF_WORKER_COUNT=5
UPLOAD_QUEUE_MAXSIZE=2000
MAX_UPLOAD_MB=25

# --- Email intake (optional; leave IMAP_PASSWORD blank to disable) ---
# Watches a mailbox over IMAP. Only mail that arrives AFTER the server starts is
# read; each PDF attachment is extracted and its JSON is handed out once by
# GET /api/v1/invoices/new. The email is marked read once all its PDFs are done.
# For Gmail/Yahoo/Outlook.com with 2FA enabled, this must be an app password, not the
# regular account password.
#   Gmail: Google Account > Security > 2-Step Verification, then App passwords;
#   also enable IMAP in Gmail > Settings > Forwarding and POP/IMAP.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USERNAME=you@gmail.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Uncomment to move fully-ingested messages here instead of just marking them Seen.
# IMAP_PROCESSED_FOLDER=Processed
IMAP_POLL_INTERVAL_SECONDS=60
# A PDF that fails extraction is retried on this many polls (email stays unread), then a
# "failed" result is handed out and the email is marked read.
EMAIL_MAX_ATTEMPTS=3
# Socket timeout for the IMAP connection - a dropped connection fails the cycle (and is
# retried next poll) instead of hanging the ingester.
IMAP_TIMEOUT_SECONDS=30
